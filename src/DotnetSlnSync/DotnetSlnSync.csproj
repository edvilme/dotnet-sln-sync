<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	  <PackAsTool>true</PackAsTool>
    <IsPublishable>true</IsPublishable>
    <ToolCommandName>dotnet-sln-sync</ToolCommandName>
    <PackageOutputPath>$(SolutionDir)nupkg/</PackageOutputPath>
    <PackageId>dotnet-sln-sync</PackageId>
    <AssemblyName>dotnet-sln-sync</AssemblyName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>3.0.1</Version>
    <Authors>Eduardo Villalpando</Authors>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/edvilme/dotnet-sln-sync</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>sln, slnx, solution</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(SolutionDir)README.md" Pack="true" PackagePath="\" />
    <None Include="$(SolutionDir)LICENSE" Pack="true" PackagePath="\" />
    <None Include="$(SolutionDir)Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
